# LLM key: set ONE of these. Gemini has a free tier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: gemini-3.5-flash-lite (Gemini) / claude-sonnet-5-5 (Anthropic)
# AUTOAPPLY_LLM_PROVIDER=gemini
# AUTOAPPLY_MODEL=
AUTOAPPLY_ONE_CLICK=true
AUTOAPPLY_HEADLESS=false
AUTOAPPLY_REVIEW_BEFORE_SUBMIT=true
AUTOAPPLY_AUTO_APPROVE_RESUME=false
AUTOAPPLY_MATCH_THRESHOLD=70
AUTOAPPLY_DAILY_CAP=20
AUTOAPPLY_MAX_AGE_HOURS=72
# Optional: mailbox for emailed verification codes
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
